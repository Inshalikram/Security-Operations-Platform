# ==============================================================================
# Security Operations Platform (SOP) — Master Environment Configuration Template
# NOTE: Never commit real credentials to git. Copy this file to .env or
# .env.production on your deployment server and populate with secure random secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Host & Domain Routing
# ------------------------------------------------------------------------------
HOST_IP=169.58.221.49
DOMAIN_SUFFIX=169-58-221-49.nip.io
LETSENCRYPT_EMAIL=inshalikram06@gmail.com

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=sop_admin
POSTGRES_PASSWORD=generate_strong_password_here_min_32_chars
POSTGRES_DB=sop_db
# Format: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
DATABASE_URL=postgresql://sop_admin:generate_strong_password_here_min_32_chars@postgres:5432/sop_db

# ------------------------------------------------------------------------------
# 3. Cache & Idempotency (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. Object Storage (MinIO S3 Compatible)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=sop_admin
MINIO_ROOT_PASSWORD=generate_strong_password_here_min_32_chars
MINIO_ENDPOINT=minio:9000

# ------------------------------------------------------------------------------
# 5. Identity & Access Management (Keycloak)
# ------------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=generate_strong_password_here_min_32_chars
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/sop_db
KC_DB_USERNAME=sop_admin
KC_DB_PASSWORD=generate_strong_password_here_min_32_chars
KEYCLOAK_URL=http://169.58.221.49:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=soc-platform
KEYCLOAK_CLIENT_ID=soc-platform-backend
KEYCLOAK_CLIENT_SECRET=generate_strong_client_secret_from_keycloak_admin_ui

# NextAuth / Frontend Keycloak Configuration
AUTH_KEYCLOAK_ID=soc-platform-frontend
AUTH_KEYCLOAK_SECRET=generate_strong_client_secret_from_keycloak_admin_ui
AUTH_KEYCLOAK_ISSUER=http://169.58.221.49:8080/realms/soc-platform
AUTH_KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/realms/soc-platform
AUTH_URL=http://169.58.221.49:3000
AUTH_SECRET=generate_random_hex_32_bytes_using_openssl_rand_hex_32
NEXT_PUBLIC_API_URL=https://api.169-58-221-49.nip.io

# ------------------------------------------------------------------------------
# 6. SIEM & Log Engine (Wazuh Indexer & Manager)
# ------------------------------------------------------------------------------
INDEXER_URL=https://wazuh-indexer:9200
INDEXER_USERNAME=admin
INDEXER_PASSWORD=generate_strong_indexer_password_here
WAZUH_INDEXER_URL=https://wazuh.indexer:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=generate_strong_indexer_password_here

API_USERNAME=wazuh
API_PASSWORD=generate_strong_wazuh_api_password_here
WAZUH_API_URL=https://wazuh-manager:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=generate_strong_wazuh_api_password_here

# ------------------------------------------------------------------------------
# 7. Observability (Grafana, Loki, Tempo, Prometheus)
# ------------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=generate_strong_grafana_password_here
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
ENABLE_OTEL=true

# ------------------------------------------------------------------------------
# 8. Workflow Automation (n8n)
# ------------------------------------------------------------------------------
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=generate_strong_n8n_password_here
N8N_ENCRYPTION_KEY=generate_random_encryption_key_here

# ------------------------------------------------------------------------------
# 9. Incident Management (TheHive)
# ------------------------------------------------------------------------------
THEHIVE_URL=http://thehive:9000
THEHIVE_API_KEY=generate_from_thehive_ui_admin_users
MAILER_USER=notifications@yourdomain.com
MAILER_PASSWORD=generate_smtp_app_password_here
MAILER_FROM=soc-alerts@yourdomain.com

# ------------------------------------------------------------------------------
# 10. External Threat Intelligence Providers
# ------------------------------------------------------------------------------
VIRUSTOTAL_API_KEY=your_virustotal_api_key_v3
ABUSEIPDB_API_KEY=your_abuseipdb_api_key
OTX_API_KEY=your_alienvault_otx_api_key
URLSCAN_API_KEY=your_urlscan_api_key
SHODAN_API_KEY=your_shodan_api_key

# ------------------------------------------------------------------------------
# 11. AI Gateway & LLMs
# ------------------------------------------------------------------------------
AI_PROVIDER=ollama
OLLAMA_URL=http://host.docker.internal:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 12. Internal Security & Service Communication
# ------------------------------------------------------------------------------
API_KEYS=generate_random_internal_api_key_for_webhook_and_service_auth
