# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — never commit real credentials.

contabo_client_id     = "your-contabo-oauth2-client-id"
contabo_client_secret = "your-contabo-oauth2-client-secret"
contabo_user           = "your-contabo-account-email"
contabo_password        = "your-contabo-account-password"

contabo_region        = "EU"
instance_display_name = "soc-platform-vps"
instance_product_id   = "V45"
ssh_key_ids            = []