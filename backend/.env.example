# ── Backend Environment Configuration Template ──
# Copy to backend/.env for local development. Never commit backend/.env to git.

DATABASE_URL=postgresql://sop_admin:generate_strong_password_here@postgres:5432/sop_db
REDIS_HOST=redis
REDIS_PORT=6379

MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=sop_admin
MINIO_ROOT_PASSWORD=generate_strong_password_here

KEYCLOAK_URL=http://169.58.221.49:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=soc-platform
KEYCLOAK_CLIENT_ID=soc-platform-backend
KEYCLOAK_CLIENT_SECRET=generate_from_keycloak_admin_ui

WAZUH_INDEXER_URL=https://wazuh.indexer:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=generate_strong_indexer_password_here
WAZUH_API_URL=https://wazuh-manager:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=generate_strong_wazuh_api_password_here

THEHIVE_URL=http://thehive:9000
THEHIVE_API_KEY=generate_from_thehive_ui_admin_users

VIRUSTOTAL_API_KEY=your_virustotal_api_key_v3
ABUSEIPDB_API_KEY=your_abuseipdb_api_key
OTX_API_KEY=your_alienvault_otx_api_key
URLSCAN_API_KEY=your_urlscan_api_key
SHODAN_API_KEY=your_shodan_api_key

AI_PROVIDER=ollama
OLLAMA_URL=http://host.docker.internal:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
ENABLE_OTEL=true

API_KEYS=generate_random_secret_internal_key
